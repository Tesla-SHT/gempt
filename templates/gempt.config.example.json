{
  "version": 1,
  "magpie": {
    "base_url": "http://127.0.0.1:3425",
    "api_key": "",
    "api_key_env": "GEMPT_MAGPIE_API_KEY",
    "cli_path": ""
  },
  "codex": {
    "cli_path": "",
    "default_sandbox": "workspace-write",
    "approval_policy": "never",
    "model_provider": "",
    "extra_args": [],
    "timeout_sec": 3600
  },
  "routing_policy": {
    "work_split": "balanced",
