    "native_swarm": true,
    "swarm_shell_model": "gemini-4-hydrogen-low",
    "default_tier": "sonnet",
    "failover_mode": "subscription_only",
    "auto_effort": false,
    "magpie_group_strategy": "order",
    "excluded_models": []
