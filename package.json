{
  "name": "gempt",
  "version": "0.1.0",
  "description": "Magpie tools + control page plugin for Gemini-leads-GPT 3+1 routing tiers (Sonnet / Opus / Fable + Chore) across every Magpie client.",
  "type": "module",
  "main": "./magpie_plugin/index.mjs",
  "exports": {
    ".": "./magpie_plugin/index.mjs"
  },
  "scripts": {
    "build:mcp-app": "node mcp_app/build.mjs"
  },
  "files": [
    "magpie_plugin/index.mjs",
    "magpie_plugin/lib/*.mjs",
    "magpie_plugin/page/*.{html,js,svg}",
    "magpie_plugin/ui/*.{html,js,css}",
    "src/gempt/*.py",
    "src/gempt/workload.json",
    "src/gempt/mcp_app_live.html",
    "mcp_app/*.{mjs,js,html,css}",
    "plugin/plugin.json",
    "plugin/mcp_config.json",
    "plugin/hooks.json",
    "plugin/work_split_hook.py",
    "plugin/rules/AGENTS.md",
    "plugin/agents/*.md",
    "plugin/skills/*/SKILL.md",
    "plugin/skills/*/references/*.md",
    "templates/gempt.config.example.json",
    "templates/magpie-groups.template.json",
    "pyproject.toml",
    "install.sh",
    "install.ps1",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tesla-SHT/gempt.git"
  },
  "engines": {
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "magpie-tools",
    "mcp",
    "opencode",
    "opencode-plugin",
    "gempt",
    "routing"
  ],
  "license": "MIT",
  "magpie": {
    "name": "GemPT",
    "summary": {
      "en": "Gemini-leads-GPT 3+1 orchestration tools (gempt_dispatch / gempt_consult / gempt_exec / gempt_discover / gempt_status) and routing control panel for all Magpie clients.",
      "zh": "为所有 Magpie 客户端提供 Gemini 主导 GPT 五档工作分工与编排工具（gempt_dispatch / gempt_consult / gempt_exec / gempt_discover / gempt_status）与订阅路由控制面板。"
    },
    "page": {
      "title": "GemPT",
      "titles": {
        "en": "GemPT",
        "zh": "GemPT",
        "zh-TW": "GemPT"
      },
      "file": "magpie_plugin/page/index.html",
      "icon": "magpie_plugin/page/icon.svg",
      "service": {
        "port": 3498,
        "option": "port"
      }
    },
    "options": {
      "port": 3498,
      "exec": false
    },
    "permissions": [],
    "icon": "data:image/svg+xml;base64,"
  }
}
