{
  "name": "gempt",
  "version": "0.4.1",
  "description": "Antigravity MCP orchestration with Gemini-to-Codex pairing and Magpie direct routing groups for other clients.",
  "author": {
    "name": "yizhang-dream",
    "url": "https://github.com/yizhang-dream"
  },
  "homepage": "https://github.com/yizhang-dream/gempt#readme",
  "bugs": {
    "url": "https://github.com/yizhang-dream/gempt/issues"
  },
  "type": "module",
  "bin": {
    "gempt": "./bin/gempt.mjs",
    "gempt-wait": "./core/wait.mjs"
  },
  "main": "./magpie_plugin/index.mjs",
  "exports": {
    ".": "./magpie_plugin/index.mjs"
  },
  "scripts": {
    "build:mcp-app": "node mcp_app/build.mjs",
    "build:agy-plugin": "node scripts/build-agy-plugin.mjs",
    "test": "node --test tests/test_core_node.mjs tests/test_magpie_plugin.mjs"
  },
  "files": [
    "bin/gempt.mjs",
    "core/**/*.mjs",
    "core/assets/*",
    "magpie_plugin/index.mjs",
    "magpie_plugin/lib/*.mjs",
    "magpie_plugin/page/*.{html,js,svg}",
    "magpie_plugin/ui/*.{html,js,css}",
    "mcp_app/*.{mjs,js,html,css}",
    "plugin/plugin.json",
    "plugin/README.md",
    "plugin/mcp_config.json",
    "plugin/hooks.json",
    "plugin/work_split_hook.mjs",
    "plugin/assets/**/*",
    "plugin/rules/AGENTS.md",
    "plugin/agents/*.md",
    "plugin/skills/*/SKILL.md",
    "plugin/skills/*/references/*.md",
    "scripts/build-agy-plugin.mjs",
    "templates/*",
    "install.sh",
    "install.ps1",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yizhang-dream/gempt.git"
  },
  "engines": {
    "node": ">=20.11.0",
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "magpie-tools",
    "mcp",
    "opencode",
    "opencode-plugin",
    "gempt",
    "routing"
  ],
  "license": "MIT",
  "magpie": {
    "name": "GemPT",
    "summary": {
      "en": "Gemini-to-Codex pairing and MCP controls for Antigravity, plus direct Magpie routing groups for other clients.",
      "zh": "为 Antigravity 提供 Gemini 与 Codex 配对及 MCP 精细控制，为其他客户端提供 Magpie 直连路由组。"
    },
    "page": {
      "title": "GemPT",
      "titles": {
        "en": "GemPT",
        "zh": "GemPT",
        "zh-TW": "GemPT"
      },
      "file": "magpie_plugin/page/index.html",
      "icon": "magpie_plugin/page/icon.svg",
      "service": {
        "port": 3498,
        "option": "port"
      }
    },
    "options": {
      "port": 3498,
      "exec": false,
      "mcpTools": true
    },
    "permissions": [],
    "icon": "data:image/svg+xml;base64,"
  }
}
