{
  "name": "gempt",
  "version": "0.2.2",
  "description": "Magpie tools + control page plugin for Gemini-leads-GPT 3+1 routing tiers (Sonnet / Opus / Fable + Chore) across every Magpie client.",
  "type": "module",
  "bin": {
    "gempt": "./bin/gempt.mjs",
    "gempt-wait": "./core/wait.mjs"
  },
  "main": "./magpie_plugin/index.mjs",
  "exports": {
    ".": "./magpie_plugin/index.mjs"
  },
  "scripts": {
    "build:mcp-app": "node mcp_app/build.mjs"
  },
  "files": [
    "bin/gempt.mjs",
    "core/**/*.mjs",
    "core/assets/*",
    "magpie_plugin/index.mjs",
    "magpie_plugin/lib/*.mjs",
    "magpie_plugin/page/*.{html,js,svg}",
    "magpie_plugin/ui/*.{html,js,css}",
    "mcp_app/*.{mjs,js,html,css}",
    "plugin/plugin.json",
    "plugin/mcp_config.json",
    "plugin/hooks.json",
    "plugin/work_split_hook.mjs",
    "plugin/assets/**/*",
    "plugin/rules/AGENTS.md",
    "plugin/agents/*.md",
    "plugin/skills/*/SKILL.md",
    "plugin/skills/*/references/*.md",
    "templates/*",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yizhang-dream/gempt.git"
  },
  "engines": {
    "node": ">=20.11.0",
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-page",
    "magpie-plugin",
    "magpie-tools",
    "mcp",
    "opencode",
    "opencode-plugin",
    "gempt",
    "routing"
  ],
  "license": "MIT",
  "magpie": {
    "name": "GemPT",
    "summary": {
      "en": "Gemini-leads-GPT orchestration tools (gempt_run / gempt_ask / gempt_ctl) and routing control panel for all Magpie clients.",
      "zh": "为所有 Magpie 客户端提供 Gemini 主导的 GPT 编排工具（gempt_run / gempt_ask / gempt_ctl）与订阅路由控制面板。"
    },
    "page": {
      "title": "GemPT",
      "titles": {
        "en": "GemPT",
        "zh": "GemPT",
        "zh-TW": "GemPT"
      },
      "file": "magpie_plugin/page/index.html",
      "icon": "magpie_plugin/page/icon.svg",
      "service": {
        "port": 3498,
        "option": "port"
      }
    },
    "options": {
      "port": 3498,
      "exec": false,
      "mcpTools": true
    },
    "permissions": [],
    "icon": "data:image/svg+xml;base64,"
  }
}
